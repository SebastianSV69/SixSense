<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F6"
    android:padding="24dp">

    <!-- ENCABEZADO: Logo Nexo -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:drawable/ic_menu_my_calendar"
            android:contentDescription="Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nexo"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#133B2B"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- CENTRO: Avatar, Bienvenida e Indicadores de PIN -->
    <LinearLayout
        android:id="@+id/layoutCenter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintBottom_toTopOf="@id/layoutKeypad"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Avatar circular -->
        <View
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@android:drawable/ic_menu_myplaces" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BIENVENIDO DE NUEVO"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#8A9A8B"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.1"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hola, Alex"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#133B2B"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingresa tu PIN para acceder a tu sistema."
            android:textSize="12sp"
            android:textColor="#707070"
            android:layout_marginTop="4dp"/>

        <!-- Círculos de PIN -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">

            <View android:layout_width="12dp" android:layout_height="12dp" android:background="@android:drawable/presence_invisible" android:layout_margin="8dp"/>
            <View android:layout_width="12dp" android:layout_height="12dp" android:background="@android:drawable/presence_invisible" android:layout_margin="8dp"/>
            <View android:layout_width="12dp" android:layout_height="12dp" android:background="@android:drawable/presence_invisible" android:layout_margin="8dp"/>
            <View android:layout_width="12dp" android:layout_height="12dp" android:background="@android:drawable/presence_invisible" android:layout_margin="8dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- TECLADO NUMÉRICO -->
    <GridLayout
        android:id="@+id/layoutKeypad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:alignmentMode="alignMargins"
        app:layout_constraintTop_toBottomOf="@id/layoutCenter"
        app:layout_constraintBottom_toTopOf="@id/layoutBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button android:text="1" style="?android:attr/buttonStyleSmall" android:layout_width="75dp" android:layout_height="65dp" android:backgroundTint="#00000000" android:textColor="#133B2B" android:textSize="22sp"/>
        <Button android:text="2" style="?android:attr/buttonStyleSmall" android:layout_width="75dp" android:layout_height="65dp" android:backgroundTint="#00000000" android:textColor="#133B2B" android:textSize="22sp"/>
        <Button android:text="3" style="?android:attr/buttonStyleSmall" android:layout_width="75dp" android:layout_height="65dp" android:backgroundTint="#00000000" android:textColor="#133B2B" android:textSize="22sp"/>

        <Button android:text="4" style="?android:attr/buttonStyleSmall" android:layout_width="75dp" android:layout_height="65dp" android:backgroundTint="#00000000" android:textColor="#133B2B" android:textSize="22sp"/>
        <Button android:text="5" style="?android:attr/buttonStyleSmall" android:layout_width="75dp" android:layout_height="65dp" android:backgroundTint="#00000000" android:textColor="#133B2B" android:textSize="22sp"/>
        <Button android:text="6" style="?android:attr/buttonStyleSmall" android:layout_width="75dp" android:layout_height="65dp" android:backgroundTint="#00000000" android:textColor="#133B2B" android:textSize="22sp"/>

        <Button android:text="7" style="?android:attr/buttonStyleSmall" android:layout_width="75dp" android:layout_height="65dp" android:backgroundTint="#00000000" android:textColor="#133B2B" android:textSize="22sp"/>
        <Button android:text="8" style="?android:attr/buttonStyleSmall" android:layout_width="75dp" android:layout_height="65dp" android:backgroundTint="#00000000" android:textColor="#133B2B" android:textSize="22sp"/>
        <Button android:text="9" style="?android:attr/buttonStyleSmall" android:layout_width="75dp" android:layout_height="65dp" android:backgroundTint="#00000000" android:textColor="#133B2B" android:textSize="22sp"/>

        <Space android:layout_width="75dp" android:layout_height="65dp"/>
        <Button android:text="0" style="?android:attr/buttonStyleSmall" android:layout_width="75dp" android:layout_height="65dp" android:backgroundTint="#00000000" android:textColor="#133B2B" android:textSize="22sp"/>
        <Button android:text="⌫" style="?android:attr/buttonStyleSmall" android:layout_width="75dp" android:layout_height="65dp" android:backgroundTint="#00000000" android:textColor="#133B2B" android:textSize="22sp"/>
    </GridLayout>

    <!-- PARTE INFERIOR -->
    <LinearLayout
        android:id="@+id/layoutBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnDesbloquear"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Desbloquear"
            android:textColor="#133B2B"
            android:backgroundTint="#A8BCAE"
            android:textStyle="bold"
            app:cornerRadius="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usar contraseña"
            android:textColor="#133B2B"
            android:textStyle="bold"
            android:layout_marginTop="10dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔒 " android:textSize="11sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Conexión protegida" android:textSize="11sp" android:textColor="#707070"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>