<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pantalla_bloqueo"
    android:orientation="vertical"
    android:paddingStart="30dp"
    android:paddingTop="28dp"
    android:paddingEnd="30dp"
    android:paddingBottom="22dp"
    tools:context=".PantallaBloqueo">

    <!-- Marca -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_logo_marca"
            android:elevation="6dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/iq_shield"
                app:tint="#F7FBF8" />

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_punto" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="SixSense"
            android:textColor="@color/texto_principal"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Contenido central con scroll (pantallas pequeñas / teclado) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="32dp">

            <FrameLayout
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginBottom="22dp"
                android:background="@drawable/bg_avatar_usuario">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/iq_user"
                    app:tint="@color/verde_avatar" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.15"
                android:text="BIENVENIDO DE NUEVO"
                android:textColor="@color/eyebrow"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSaludo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:letterSpacing="-0.04"
                android:textColor="@color/texto_principal"
                android:textSize="32sp"
                tools:text="Hola, Alex" />

            <TextView
                android:id="@+id/tvInstruccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:layout_marginBottom="26dp"
                android:gravity="center"
                android:text="@string/bloqueo_instruccion_pin"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <!-- Modo PIN -->
            <LinearLayout
                android:id="@+id/panelPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/contenedorPuntos"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginBottom="20dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/punto1"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="4.5dp"
                        android:layout_marginEnd="4.5dp"
                        android:background="@drawable/bg_pin_punto" />

                    <View
                        android:id="@+id/punto2"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="4.5dp"
                        android:layout_marginEnd="4.5dp"
                        android:background="@drawable/bg_pin_punto" />

                    <View
                        android:id="@+id/punto3"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="4.5dp"
                        android:layout_marginEnd="4.5dp"
                        android:background="@drawable/bg_pin_punto" />

                    <View
                        android:id="@+id/punto4"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="4.5dp"
                        android:layout_marginEnd="4.5dp"
                        android:background="@drawable/bg_pin_punto" />
                </LinearLayout>

                <!-- Teclado numérico -->
                <LinearLayout
                    android:layout_width="244dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tecla1"
                            android:layout_width="58dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="11.5dp"
                            android:layout_marginEnd="11.5dp"
                            android:background="@drawable/bg_tecla"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/texto_teclas"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tecla2"
                            android:layout_width="58dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="11.5dp"
                            android:layout_marginEnd="11.5dp"
                            android:background="@drawable/bg_tecla"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="2"
                            android:textColor="@color/texto_teclas"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tecla3"
                            android:layout_width="58dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="11.5dp"
                            android:layout_marginEnd="11.5dp"
                            android:background="@drawable/bg_tecla"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="3"
                            android:textColor="@color/texto_teclas"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tecla4"
                            android:layout_width="58dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="11.5dp"
                            android:layout_marginEnd="11.5dp"
                            android:background="@drawable/bg_tecla"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="4"
                            android:textColor="@color/texto_teclas"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tecla5"
                            android:layout_width="58dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="11.5dp"
                            android:layout_marginEnd="11.5dp"
                            android:background="@drawable/bg_tecla"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="5"
                            android:textColor="@color/texto_teclas"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tecla6"
                            android:layout_width="58dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="11.5dp"
                            android:layout_marginEnd="11.5dp"
                            android:background="@drawable/bg_tecla"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="6"
                            android:textColor="@color/texto_teclas"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tecla7"
                            android:layout_width="58dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="11.5dp"
                            android:layout_marginEnd="11.5dp"
                            android:background="@drawable/bg_tecla"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="7"
                            android:textColor="@color/texto_teclas"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tecla8"
                            android:layout_width="58dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="11.5dp"
                            android:layout_marginEnd="11.5dp"
                            android:background="@drawable/bg_tecla"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="8"
                            android:textColor="@color/texto_teclas"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tecla9"
                            android:layout_width="58dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="11.5dp"
                            android:layout_marginEnd="11.5dp"
                            android:background="@drawable/bg_tecla"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="9"
                            android:textColor="@color/texto_teclas"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="58dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="11.5dp"
                            android:layout_marginEnd="11.5dp"
                            android:importantForAccessibility="no"
                            android:visibility="invisible" />

                        <TextView
                            android:id="@+id/tecla0"
                            android:layout_width="58dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="11.5dp"
                            android:layout_marginEnd="11.5dp"
                            android:background="@drawable/bg_tecla"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="@color/texto_teclas"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:id="@+id/teclaBorrar"
                            android:layout_width="58dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="11.5dp"
                            android:layout_marginEnd="11.5dp"
                            android:background="@drawable/bg_tecla"
                            android:clickable="true"
                            android:contentDescription="Borrar último dígito"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_backspace"
                                app:tint="@color/texto_secundario" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Modo contraseña -->
            <LinearLayout
                android:id="@+id/panelContrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_marginBottom="8dp"
                    android:labelFor="@id/etContrasena"
                    android:text="Contraseña"
                    android:textColor="@color/texto_etiqueta"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:addStatesFromChildren="true"
                    android:background="@drawable/bg_campo_texto"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/texto_icono_campo" />

                    <EditText
                        android:id="@+id/etContrasena"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:autofillHints="password"
                        android:background="@null"
                        android:hint="Ingresa tu contraseña"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/texto_principal"
                        android:textColorHint="@color/texto_hint"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Acciones -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDesbloquear"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_primario"
        android:enabled="false"
        android:stateListAnimator="@null"
        android:text="Desbloquear"
        android:textAllCaps="false"
        android:textColor="@color/blanco"
        android:textSize="15sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAlternarModo"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:text="@string/bloqueo_usar_contrasena"
        android:textAllCaps="false"
        android:textColor="@color/verde_texto_enlace"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lock"
            app:tint="@color/texto_pie" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="Conexión protegida"
            android:textColor="@color/texto_pie"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>