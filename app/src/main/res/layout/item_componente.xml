<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/divisor"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divisor" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/cajaIcono"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_caja_icono"
            android:backgroundTint="@color/verde_icono_fondo">

            <ImageView
                android:id="@+id/ivIcono"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/verde_icono"
                tools:src="@drawable/ic_vibration" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_principal"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Sensor de vibración" />

            <TextView
                android:id="@+id/tvRol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/texto_terciario"
                android:textSize="11sp"
                tools:text="Zona principal" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLectura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/verde_lectura"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="0.02 g" />

            <TextView
                android:id="@+id/tvEtiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/texto_terciario"
                android:textSize="11sp"
                tools:text="Sin vibraciones" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>