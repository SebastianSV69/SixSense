<!-- bg_boton_punteado.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/verde_chip_fondo" />
            <stroke
                android:width="1.2dp"
                android:color="@color/borde_punteado"
                android:dashGap="5dp"
                android:dashWidth="6dp" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fondo_punteado" />
            <stroke
                android:width="1.2dp"
                android:color="@color/borde_punteado"
                android:dashGap="5dp"
                android:dashWidth="6dp" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>