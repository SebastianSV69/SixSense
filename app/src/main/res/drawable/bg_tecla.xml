<!-- bg_tecla.xml (fondo translúcido solo mientras se presiona) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="60"
    android:exitFadeDuration="180">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#331D5C48" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#001D5C48" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>