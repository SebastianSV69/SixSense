<!-- bg_radio_opcion.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/blanco" />
                    <stroke android:width="1.5dp" android:color="@color/verde_seleccion" />
                </shape>
            </item>
            <item
                android:bottom="4dp"
                android:left="4dp"
                android:right="4dp"
                android:top="4dp">
                <shape android:shape="oval">
                    <solid android:color="@color/verde_seleccion" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/blanco" />
            <stroke android:width="1.5dp" android:color="@color/borde_campo" />
        </shape>
    </item>
</selector>